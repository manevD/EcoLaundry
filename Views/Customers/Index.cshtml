@using EcoLaundry.Entities
@model IEnumerable<Customer>

@{
    ViewData["Title"] = "Клиенти";

    var customers =
        Model ?? Enumerable.Empty<Customer>();
}

<div class="container-fluid">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4 class="mb-0">
            Клиенти
        </h4>

        <div class="d-flex gap-2">

            <!-- EXCEL -->
            <a asp-action="ExportCustomersExcel"
               id="exportCustomersExcel"
               class="btn btn-outline-success btn-sm">
                📊 Excel
            </a>

            <!-- NEW -->
            <a asp-action="Create"
               class="btn btn-primary btn-sm">
                + Нов клиент
            </a>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SEARCH -->
    <!-- ===================================================== -->

    <div class="mb-3">

        <input type="text"
               id="searchInput"
               class="form-control form-control-lg"
               placeholder="🔍 Барај по име или телефон..." />

    </div>


    <!-- ===================================================== -->
    <!-- NO CUSTOMERS -->
    <!-- ===================================================== -->
    @if (!customers.Any())
    {
        <div class="alert alert-info text-center">
            Нема клиенти
        </div>
    }


    <!-- ===================================================== -->
    <!-- MOBILE VIEW -->
    <!-- ===================================================== -->

    <div class="d-md-none"
         id="mobileCustomers">

        @foreach (var item in customers)
        {
            <div class="card shadow-sm mb-3 customer-card"
                 data-id="@item.Id">

                <div class="card-body">

                    <!-- NAME -->
                    <h5 class="card-title mb-1">
                        @item.FirstName @item.LastName
                    </h5>


                    <!-- PHONE -->
                    <p class="text-muted mb-2">
                        📞 @item.Phone
                    </p>


                    <!-- ORDERS -->
                    <small class="text-muted">
                        Нарачки:
                        @item.Orders.Count
                    </small>


                    <!-- BUTTONS -->
                    <div class="mt-3 d-flex gap-2">

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary btn-sm flex-fill">
                            Детали
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-secondary btn-sm flex-fill">
                            Измени
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>


    <!-- ===================================================== -->
    <!-- DESKTOP VIEW -->
    <!-- ===================================================== -->

    <div class="table-responsive d-none d-md-block">

        <table class="table table-hover align-middle"
               id="customersTable">

            <thead>

                <tr>

                    <th>
                        Име
                    </th>

                    <th>
                        Телефон
                    </th>

                    <th>
                        Нарачки
                    </th>

                    <th class="text-end">
                        Акција
                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in customers)
                {
                    <tr data-id="@item.Id">

                        <!-- NAME -->
                        <td>

                            <strong>
                                @item.FirstName @item.LastName
                            </strong>

                        </td>


                        <!-- PHONE -->
                        <td>
                            @item.Phone
                        </td>


                        <!-- ORDERS -->
                        <td>

                            <span class="badge bg-secondary">
                                @item.Orders.Count
                            </span>

                        </td>


                        <!-- ACTIONS -->
                        <td class="text-end">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Детали
                            </a>


                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Измени
                            </a>


                            @if (User.IsInRole("Admin"))
                            {
                                <button type="button"
                                        class="btn btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-id="@item.Id"
                                        data-name="@item.FirstName">

                                    🗑️ Избриши

                                </button>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<!-- ========================================================= -->
<!-- DELETE MODAL -->
<!-- ========================================================= -->

<div class="modal fade"
     id="deleteModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <!-- HEADER -->

            <div class="modal-header">

                <h5 class="modal-title">
                    ⚠️ Потврда за бришење
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- BODY -->

            <div class="modal-body">

                <p id="deleteText">
                </p>

                <div class="alert alert-danger">

                    <strong>
                        Внимание!
                    </strong>

                    <br />

                    Со бришењето на клиентот ќе се избришат
                    и сите негови нарачки.

                    Оваа акција не може да се врати.

                </div>

            </div>


            <!-- FOOTER -->

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Откажи

                </button>


                <form id="deleteForm"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger">

                        🗑️ Избриши

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- ========================================================= -->
<!-- SCRIPTS -->
<!-- ========================================================= -->
@section Scripts {

    <script>

        // =====================================================
        // DELETE MODAL
        // =====================================================

        const deleteModal =
            document.getElementById("deleteModal");

        if (deleteModal) {

            deleteModal.addEventListener(
                "show.bs.modal",
                function (event) {

                    const button =
                        event.relatedTarget;

                    const id =
                        button.dataset.id;

                    const name =
                        button.dataset.name;

                    document.getElementById("deleteText").innerHTML =
                        `Дали сте сигурни дека сакате да го избришете клиентот <strong>${name}</strong>?`;

                    document.getElementById("deleteForm").action =
                        "/Customers/Delete/" + id;

                }
            );

        }


        // =====================================================
        // SEARCH
        // =====================================================

        attachSearch(
            "searchInput",
            ".customer-card"
        );

        attachSearch(
            "searchInput",
            "#customersTable tbody tr"
        );


        // =====================================================
        // EXCEL EXPORT
        // =====================================================

        const exportCustomersExcel =
            document.getElementById(
                "exportCustomersExcel"
            );


        if (exportCustomersExcel) {

            exportCustomersExcel.addEventListener(
                "click",
                function (e) {

                    e.preventDefault();


                    // Set за да нема дупликати
                    const visibleIds =
                        new Set();


                    // =================================================
                    // MOBILE
                    // =================================================

                    document
                        .querySelectorAll(".customer-card")
                        .forEach(function (card) {

                            if (
                                card.style.display !== "none"
                            ) {

                                const id =
                                    card.dataset.id;

                                if (id) {

                                    visibleIds.add(id);

                                }

                            }

                        });


                    // =================================================
                    // DESKTOP
                    // =================================================

                    document
                        .querySelectorAll(
                            "#customersTable tbody tr"
                        )
                        .forEach(function (row) {

                            if (
                                row.style.display !== "none"
                            ) {

                                const id =
                                    row.dataset.id;

                                if (id) {

                                    visibleIds.add(id);

                                }

                            }

                        });


                    // =================================================
                    // NO RESULTS
                    // =================================================

                    if (visibleIds.size === 0) {

                        alert(
                            "Нема клиенти за export."
                        );

                        return;

                    }


                    // =================================================
                    // CREATE URL
                    // =================================================

                    const url =
                        new URL(
                            this.href,
                            window.location.origin
                        );


                    url.searchParams.set(
                        "ids",
                        Array.from(visibleIds).join(",")
                    );


                    // =================================================
                    // DOWNLOAD
                    // =================================================

                    window.location.href =
                        url.toString();

                }
            );

        }

    </script>

}