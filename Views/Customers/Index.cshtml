@using EcoLaundry.Entities
@model IEnumerable<Customer>

@{
    ViewData["Title"] = "Клиенти";
    var customers = Model ?? Enumerable.Empty<Customer>();
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Клиенти</h4>

        <div class="d-flex gap-2">
            <a asp-controller="Customers"
               asp-action="ExportCustomersExcel"
               id="exportCustomersExcel"
               class="btn btn-outline-success btn-sm">
                📊 Excel
            </a>

            <a asp-action="Create"
               class="btn btn-primary btn-sm">
                + Нов клиент
            </a>
        </div>
    </div>

    <!-- SEARCH -->
    <div class="mb-3">
        <input type="text"
               id="searchInput"
               class="form-control form-control-lg"
               placeholder="🔍 Барај по име или телефон..." />
    </div>

    @if (!customers.Any())
    {
        <div class="alert alert-info text-center">
            Нема клиенти
        </div>
    }

    <!-- MOBILE VIEW -->
    <div class="d-md-none" id="mobileCustomers">
        @foreach (var item in customers)
        {
            <div class="card shadow-sm mb-3 customer-card"
                 data-id="@item.Id">

                <div class="card-body">
                    <h5 class="card-title mb-1">
                        @item.FirstName @item.LastName
                    </h5>

                    <p class="text-muted mb-2">
                        📞 @item.Phone
                    </p>

                    <small class="text-muted">
                        Нарачки: @(item.Orders?.Count ?? 0)
                    </small>

                    <div class="mt-3 d-flex gap-2">
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary btn-sm flex-fill">
                            Детали
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-secondary btn-sm flex-fill">
                            Измени
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- DESKTOP VIEW -->
    <div class="table-responsive d-none d-md-block">
        <table class="table table-hover align-middle"
               id="customersTable">

            <thead>
                <tr>
                    <th>Име</th>
                    <th>Телефон</th>
                    <th>Нарачки</th>
                    <th class="text-end">Акција</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in customers)
                {
                    <tr data-id="@item.Id">
                        <td>
                            <strong>
                                @item.FirstName @item.LastName
                            </strong>
                        </td>

                        <td>@item.Phone</td>

                        <td>
                            <span class="badge bg-secondary">
                                @(item.Orders?.Count ?? 0)
                            </span>
                        </td>

                        <td class="text-end">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Детали
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Измени
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <button type="button"
                                        class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-id="@item.Id"
                                        data-name="@($"{item.FirstName} {item.LastName}")">
                                    🗑️ Избриши
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalTitle">
                    ⚠️ Потврда за бришење
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Затвори">
                </button>
            </div>

            <div class="modal-body">
                <p id="deleteText"></p>

                <div class="alert alert-danger mb-0">
                    <strong>Внимание!</strong><br />
                    Со бришењето на клиентот може да се избришат
                    и неговите нарачки, зависно од поставените
                    правила во базата. Оваа акција не може да се врати.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Откажи
                </button>

                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-danger">
                        🗑️ Избриши
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // SEARCH
            const searchInput = document.getElementById("searchInput");

            function filterCustomers() {
                const searchText = (searchInput?.value || "")
                    .toLocaleLowerCase()
                    .trim();

                document.querySelectorAll(".customer-card").forEach(function (card) {
                    card.style.display = card.innerText
                        .toLocaleLowerCase()
                        .includes(searchText) ? "" : "none";
                });

                document.querySelectorAll("#customersTable tbody tr").forEach(function (row) {
                    row.style.display = row.innerText
                        .toLocaleLowerCase()
                        .includes(searchText) ? "" : "none";
                });
            }

            if (searchInput) {
                searchInput.addEventListener("input", filterCustomers);
            }

            // DELETE MODAL
            const deleteModal = document.getElementById("deleteModal");

            if (deleteModal) {
                deleteModal.addEventListener("show.bs.modal", function (event) {
                    const button = event.relatedTarget;

                    if (!button) return;

                    const id = button.dataset.id;
                    const name = button.dataset.name || "";

                    document.getElementById("deleteText").textContent =
                        `Дали сте сигурни дека сакате да го избришете клиентот ${name}?`;

                    document.getElementById("deleteForm").action =
                        "/Customers/Delete/" + encodeURIComponent(id);
                });
            }

            // EXCEL EXPORT
            const exportButton = document.getElementById("exportCustomersExcel");

            if (exportButton) {
                exportButton.addEventListener("click", function (event) {
                    event.preventDefault();

                    const visibleIds = new Set();

                    // Собери ги видливите мобилни картички
                    document.querySelectorAll(".customer-card").forEach(function (card) {
                        if (getComputedStyle(card).display !== "none") {
                            const id = card.dataset.id;
                            if (id) visibleIds.add(id);
                        }
                    });

                    // Собери ги видливите редови од desktop табелата
                    document.querySelectorAll("#customersTable tbody tr").forEach(function (row) {
                        if (getComputedStyle(row).display !== "none") {
                            const id = row.dataset.id;
                            if (id) visibleIds.add(id);
                        }
                    });

                    if (visibleIds.size === 0) {
                        alert("Нема клиенти за Excel export.");
                        return;
                    }

                    const url = new URL(this.href, window.location.origin);
                    url.searchParams.set("ids", Array.from(visibleIds).join(","));

                    window.location.href = url.toString();
                });
            }
        });
    </script>
}
