
@using EcoLaundry.Entities
@model IEnumerable<Order>

@{
    ViewData["Title"] = "Нарачки";

    string filter = ViewBag.Filter as string ?? "active";
    var orders = Model ?? Enumerable.Empty<Order>();
}


<style>
    /* Поголеми pagination копчиња, особено за телефони */
    .orders-pagination {
        gap: 6px;
        margin-bottom: 1rem;
    }

    .orders-pagination .page-link {
        min-width: 46px;
        min-height: 46px;
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 8px !important;
        cursor: pointer;
    }

    .orders-pagination .page-item.active .page-link {
        z-index: 1;
    }

    .orders-pagination .page-item.disabled .page-link {
        cursor: not-allowed;
    }

    @@media (max-width: 576px) {
        .orders-pagination {
            gap: 5px;
        }

        .orders-pagination .page-link {
            min-width: 44px;
            min-height: 46px;
            padding: 10px 12px;
            font-size: 1rem;
        }
    }
</style>

<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">Нарачки</h4>

        <div class="d-flex gap-2">
            <a asp-controller="Orders"
               asp-action="ExportExcel"
               asp-route-filter="@filter"
               id="exportExcel"
               class="btn btn-outline-success btn-sm">
                📊 Excel
            </a>

            <a asp-controller="Orders"
               asp-action="Create"
               class="btn btn-primary btn-sm">
                + Нова
            </a>
        </div>
    </div>

    <!-- FILTERS -->
    <div class="btn-group w-100 mb-3" role="group">

        <a asp-action="Index"
           asp-route-filter="active"
           class="btn @(filter == "active" ? "btn-primary" : "btn-outline-primary")">
            Активни
        </a>

        <a asp-action="Index"
           asp-route-filter="finished"
           class="btn @(filter == "finished" ? "btn-primary" : "btn-outline-primary")">
            Завршени
        </a>

        <a asp-action="Index"
           asp-route-filter="delivered"
           class="btn @(filter == "delivered" ? "btn-primary" : "btn-outline-primary")">
            Подигнати
        </a>

        <a asp-action="Index"
           asp-route-filter="cancelled"
           class="btn @(filter == "cancelled" ? "btn-primary" : "btn-outline-primary")">
            Откажани
        </a>

        <a asp-action="Index"
           asp-route-filter="all"
           class="btn @(filter == "all" ? "btn-primary" : "btn-outline-primary")">
            Сите
        </a>

    </div>

    <!-- SEARCH -->
    <input type="text"
           id="orderSearch"
           class="form-control form-control-lg mb-3"
           placeholder="🔍 Барај клиент, телефон, облека..." />

    <!-- PAGINATION SETTINGS -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex align-items-center gap-2">
            <label for="pageSize" class="form-label mb-0">По страница:</label>
            <select id="pageSize" class="form-select form-select-sm" style="width:auto;">
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
        <small id="resultsInfo" class="text-muted"></small>
    </div>

    <!-- ORDERS -->
    <div id="ordersContainer">

        @if (!orders.Any())
        {
            <div class="alert alert-info text-center">
                Нема нарачки во оваа категорија.
            </div>
        }
        else
        {
            @foreach (var order in orders.ToList().OrderByDescending(x => x.ReceivedDate))
            {
                <div class="card shadow-sm mb-3 order-card"
                     data-id="@order.Id">

                    <div class="card-body">

                        <!-- CUSTOMER AND PRICE -->
                        <div class="d-flex justify-content-between gap-3">
                            <div>
                                <h5 class="mb-1">
                                    #@(order.OrderNumber ?? "-")
                                </h5>

                                <strong>
                                    @(order.Customer != null
                                        ? $"{order.Customer.FirstName} {order.Customer.LastName}"
                                        : "Непознат клиент")
                                </strong>

                                @if (order.Customer != null)
                                {
                                    <br />
                                    <small class="text-muted">
                                        📞 @(order.Customer.Phone ?? "")
                                    </small>
                                }
                            </div>

                            <div class="text-end">
                                @if (order.IsExpress)
                                {
                                    <span class="badge bg-danger">
                                        🔥 EXPRESS
                                    </span>
                                }

                                @if (order.PickedUp)
                                {
                                    <span class="badge bg-secondary">
                                        Подигнато
                                    </span>
                                }

                                <div class="mt-2">
                                    <strong>
                                        @(order.TotalPrice.HasValue
                                            ? $"{order.TotalPrice.Value:N0} ден"
                                            : "-")
                                    </strong>
                                </div>
                            </div>
                        </div>

                        <hr class="my-2" />

                        <!-- ITEMS -->
                        @foreach (var item in order.Items ?? Enumerable.Empty<OrderItem>())
                        {
                            <div class="d-flex justify-content-between gap-3 mb-1">
                                <div>
                                    ✓ @(item.LaundryCategory?.Name ?? "Непознато")

                                    <span class="badge bg-secondary">
                                        x @item.Quantity
                                    </span>
                                </div>

                                <div class="text-end">
                                    <strong>
                                        @(item.Quantity * item.Price) ден
                                    </strong>
                                    <br />
                                    <small class="text-muted">
                                        @item.Quantity x @item.Price
                                    </small>
                                </div>
                            </div>
                        }

                        <hr class="my-2" />

                        <!-- DATE AND STATUS -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <span>
                                📅 @order.ReceivedDate.ToString("dd.MM.yyyy HH:mm")
                            </span>

                            <span>
                                @switch (order.Status)
                                {
                                    case OrderStatus.Received:
                                        <span class="badge bg-warning text-dark">
                                            Примено
                                        </span>
                                        break;

                                    case OrderStatus.InProgress:
                                        <span class="badge bg-info text-dark">
                                            Во обработка
                                        </span>
                                        break;

                                    case OrderStatus.Finished:
                                        <span class="badge bg-success">
                                            Завршено
                                        </span>
                                        break;

                                    case OrderStatus.Cancelled:
                                        <span class="badge bg-danger">
                                            Откажано
                                        </span>
                                        break;
                                }
                            </span>
                        </div>

                        <!-- ACTIONS -->
                        <div class="d-flex gap-2 mt-3">
                            <a asp-action="Details"
                               asp-route-id="@order.Id"
                               class="btn btn-outline-primary btn-sm flex-fill">
                                Детали
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@order.Id"
                               class="btn btn-outline-secondary btn-sm flex-fill">
                                Измени
                            </a>
                        </div>

                    </div>
                </div>
            }
        }
    </div>

    <nav class="mt-3" aria-label="Pagination">
        <ul id="ordersPagination" class="pagination justify-content-center flex-wrap orders-pagination"></ul>
    </nav>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("orderSearch");
            const exportButton = document.getElementById("exportExcel");
            const orderCards = Array.from(document.querySelectorAll(".order-card"));
            const pagination = document.getElementById("ordersPagination");
            const pageSizeSelect = document.getElementById("pageSize");
            const resultsInfo = document.getElementById("resultsInfo");

            let currentPage = 1;
            let pageSize = parseInt(pageSizeSelect?.value || "10", 10);
            let filteredCards = [...orderCards];

            function applySearch() {
                const searchText = (searchInput?.value || "")
                    .toLocaleLowerCase()
                    .trim();

                // Пребарува низ СИТЕ нарачки вчитани од серверот, не само тековната страница.
                filteredCards = orderCards.filter(card =>
                    card.innerText.toLocaleLowerCase().includes(searchText)
                );

                currentPage = 1;
                renderPage();
            }

            function renderPage() {
                const total = filteredCards.length;
                const totalPages = Math.max(1, Math.ceil(total / pageSize));

                if (currentPage > totalPages) currentPage = totalPages;

                // Прво скриј ги сите картички, па прикажи ја тековната страница од резултатите.
                orderCards.forEach(card => card.style.display = "none");

                const start = (currentPage - 1) * pageSize;
                filteredCards.slice(start, start + pageSize).forEach(card => {
                    card.style.display = "";
                });

                if (resultsInfo) {
                    resultsInfo.textContent = total === 0
                        ? "Нема резултати."
                        : `Прикажани ${start + 1}–${Math.min(start + pageSize, total)} од ${total} нарачки`;
                }

                renderPagination(totalPages);
            }

            function renderPagination(totalPages) {
                if (!pagination) return;
                pagination.innerHTML = "";

                function addButton(label, page, disabled = false, active = false) {
                    const li = document.createElement("li");
                    li.className = "page-item" +
                        (disabled ? " disabled" : "") +
                        (active ? " active" : "");

                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "page-link";
                    button.textContent = label;
                    button.disabled = disabled;
                    button.addEventListener("click", () => {
                        currentPage = page;
                        renderPage();
                        document.getElementById("ordersContainer")
                            ?.scrollIntoView({ behavior: "smooth", block: "start" });
                    });

                    li.appendChild(button);
                    pagination.appendChild(li);
                }

                addButton("«", Math.max(1, currentPage - 1), currentPage === 1);

                // При многу страници прикажи ограничен број броеви околу тековната страница.
                const first = Math.max(1, currentPage - 2);
                const last = Math.min(totalPages, currentPage + 2);

                if (first > 1) {
                    addButton("1", 1, false, currentPage === 1);
                    if (first > 2) {
                        const dots = document.createElement("li");
                        dots.className = "page-item disabled";
                        dots.innerHTML = '<span class="page-link">…</span>';
                        pagination.appendChild(dots);
                    }
                }

                for (let page = first; page <= last; page++) {
                    addButton(String(page), page, false, page === currentPage);
                }

                if (last < totalPages) {
                    if (last < totalPages - 1) {
                        const dots = document.createElement("li");
                        dots.className = "page-item disabled";
                        dots.innerHTML = '<span class="page-link">…</span>';
                        pagination.appendChild(dots);
                    }
                    addButton(String(totalPages), totalPages, false, currentPage === totalPages);
                }

                addButton("»", Math.min(totalPages, currentPage + 1), currentPage === totalPages);
            }

            searchInput?.addEventListener("input", applySearch);

            pageSizeSelect?.addEventListener("change", function () {
                pageSize = parseInt(this.value, 10) || 10;
                currentPage = 1;
                renderPage();
            });

            if (exportButton) {
                exportButton.addEventListener("click", function (event) {
                    event.preventDefault();

                    const url = new URL(this.href, window.location.origin);
                    const searchText = (searchInput?.value || "").trim();

                    // Без пребарување: ExportExcel треба да ги извезе сите нарачки од избраниот филтер.
                    if (searchText === "") {
                        url.searchParams.delete("ids");
                        window.location.href = url.toString();
                        return;
                    }

                    // Со пребарување: извези ги сите совпаѓања, вклучително и оние од другите страници.
                    const matchingIds = filteredCards
                        .map(card => card.dataset.id)
                        .filter(id => id && id.trim() !== "");

                    if (matchingIds.length === 0) {
                        alert("Нема нарачки за Excel export.");
                        return;
                    }

                    url.searchParams.set("ids", matchingIds.join(","));
                    window.location.href = url.toString();
                });
            }

            applySearch();
        });
    </script>
}
